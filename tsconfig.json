{
	// Type checking only: pi loads the TypeScript sources directly.
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"lib": ["ES2023", "DOM"],
		"types": ["node"],
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true
	},
	"include": ["extensions/**/*.ts", "test/**/*.ts"]
}
